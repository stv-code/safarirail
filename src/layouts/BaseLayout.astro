---
import '../styles/global.css'
import '../styles/refresh.css'
import Analytics from '@vercel/analytics/astro'
import { siteConfig } from '@/config/site'

const {
  title = 'SGR Booking for Tourists | Nairobi to Mombasa | Safari Rail',
  description = 'Book your Nairobi to Mombasa SGR journey with independent assistance from Safari Rail. No M-Pesa? Compare fares, request seats and get help on WhatsApp.',
  canonical = new URL(Astro.url.pathname, siteConfig.url).href,
  robots = 'index, follow',
} = Astro.props
const socialImage = `${siteConfig.url}/social-card.jpg`
const structuredData = {
  '@context': 'https://schema.org', '@type': 'TravelAgency',
  '@id': `${siteConfig.url}/#business`, name: siteConfig.name,
  description: 'Independent SGR booking assistance for travellers in Kenya. Not affiliated with Kenya Railways.',
  url: siteConfig.url, logo: `${siteConfig.url}/logo.webp`, image: socialImage,
  email: siteConfig.supportEmail, telephone: siteConfig.whatsappDisplay,
  areaServed: { '@type': 'Country', name: 'Kenya' },
  sameAs: [siteConfig.instagramUrl, siteConfig.facebookUrl],
}
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_KE" />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Safari Rail - independent SGR booking assistance" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="theme-color" content="#173c32" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <slot />
    <script is:inline>
      window.webAnalyticsBeforeSend = (event) => {
        const url = new URL(event.url)
        url.search = ''
        url.hash = ''
        return { ...event, url: url.href }
      }
    </script>
    <Analytics />
  </body>
</html>
