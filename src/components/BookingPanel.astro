---
import { bookingExperience, departures, formatKes, siteConfig, ticketClasses } from '@/config/business'
---

<form class="booking-panel booking-panel-full" id="booking-panel">
  <noscript><p>This booking form needs JavaScript. You can also <a href={`https://wa.me/${siteConfig.whatsappNumber}`}>request assistance on WhatsApp</a>.</p></noscript>
  <div class="booking-summary">
    <p class="eyebrow">Passenger Details</p>
    <h2>Request SGR booking assistance</h2>
    <p>
      Submit your details first. We confirm seat availability and payment instructions before final confirmation.
    </p>
    <p class="response-time">{bookingExperience.responseTimeLabel}</p>
    <div class="mobile-stepper" aria-label="Booking form progress">
      <span data-step-indicator="0">Trip</span>
      <span data-step-indicator="1">Passengers</span>
      <span data-step-indicator="2">Contact Details</span>
      <span data-step-indicator="3">Review & Submit</span>
    </div>
  </div>

  <fieldset class="form-step" data-step="0">
    <legend>Trip</legend>
  <div class="field">
    <label for="class">Class</label>
    <select id="class" name="class">
      {ticketClasses.map((ticketClass) => (
        <option value={ticketClass.label} data-adult={ticketClass.adultPrice} data-child={ticketClass.childPrice}>
          {ticketClass.label} - KES {formatKes(ticketClass.adultPrice)} adult
        </option>
      ))}
    </select>
  </div>
  <div class="field">
    <label for="date">Travel Date</label>
    <input id="date" name="date" type="date" required />
  </div>
  <div class="field">
    <label for="departure">Preferred Departure</label>
    <select id="departure" name="departure">
      {departures.map((departure) => <option value={departure}>{departure}</option>)}
    </select>
  </div>
  <div class="field">
    <label for="adults">Adults</label>
    <select id="adults" name="adults">
      {[1, 2, 3, 4, 5, 6].map((number) => <option value={number}>{number}</option>)}
    </select>
  </div>
  <div class="field">
    <label for="children">Children (3-11)</label>
    <select id="children" name="children">
      {[0, 1, 2, 3, 4].map((number) => <option value={number}>{number}</option>)}
    </select>
  </div>
  </fieldset>

  <fieldset class="form-step" data-step="1">
    <legend>Passengers</legend>
    <div class="passenger-list" id="passenger-list"></div>
  </fieldset>

  <fieldset class="form-step" data-step="2">
    <legend>Contact Details</legend>
  <div class="field">
    <label for="email">Email Address</label>
    <input id="email" name="email" type="email" autocomplete="email" placeholder="tickets@example.com" required />
  </div>
  <div class="privacy-consent">
    <input id="privacy-consent" name="consent" type="checkbox" required />
    <label for="privacy-consent">
      <a href={siteConfig.privacyPolicyUrl}>Privacy policy</a>.
      I consent to Safari Rail storing my booking and passenger identity details only to process this request.
      Passport/ID details are retained temporarily for booking support and can be deleted on request.
    </label>
  </div>
  </fieldset>

  <fieldset class="form-step review-step" data-step="3">
    <legend>Review & Submit</legend>
  <p class="form-status" id="booking-status" role="status" aria-live="polite"></p>
  <div class="booking-total">
    <span>Estimated Total</span>
    <strong id="booking-total">KES 2,000</strong>
    <small>Children under 3 travel free.</small>
  </div>
  <button class="primary-button" type="submit">Submit Booking Request</button>
  </fieldset>

  <div class="mobile-form-actions">
    <button class="ghost-dark-button" type="button" id="booking-prev">Back</button>
    <button class="primary-button" type="button" id="booking-next">Next</button>
  </div>
</form>


<script>
  import countries from '@/data/countries.json'
  const countryOptions = countries.map((country) => ({ code: country['alpha-2'], name: country.name }))
  const form = document.querySelector('#booking-panel')
  const dateInput = document.querySelector('#date')
  const classInput = document.querySelector('#class')
  const adultsInput = document.querySelector('#adults')
  const childrenInput = document.querySelector('#children')
  const totalOutput = document.querySelector('#booking-total')
  const statusOutput = document.querySelector('#booking-status')
  const submitButton = form?.querySelector('button[type="submit"]')

  const prevButton = document.querySelector('#booking-prev')
  const nextButton = document.querySelector('#booking-next')
  const stepElements = Array.from(document.querySelectorAll('[data-step]'))
  const stepIndicators = Array.from(document.querySelectorAll('[data-step-indicator]'))
  const passengerList = document.querySelector('#passenger-list')
  let currentStep = 0


  function getSelectedClass() {
    if (!(classInput instanceof HTMLSelectElement)) return null
    return classInput.selectedOptions[0]
  }

  function calculateTotal() {
    const selectedClass = getSelectedClass()
    if (!selectedClass || !(adultsInput instanceof HTMLSelectElement) || !(childrenInput instanceof HTMLSelectElement)) return 0

    const adultPrice = Number(selectedClass.dataset.adult || 0)
    const childPrice = Number(selectedClass.dataset.child || 0)
    const adults = Number(adultsInput.value || 1)
    const children = Number(childrenInput.value || 0)

    return adults * adultPrice + children * childPrice
  }

  function updateTotal() {
    if (!(totalOutput instanceof HTMLElement)) return
    totalOutput.textContent = `KES ${calculateTotal().toLocaleString()}`
  }

  function getPassengerCount() {
    const adults = adultsInput instanceof HTMLSelectElement ? Number(adultsInput.value || 1) : 1
    const children = childrenInput instanceof HTMLSelectElement ? Number(childrenInput.value || 0) : 0
    return Math.max(1, adults + children)
  }

  function getPassengerType(index: number) {
    const adults = adultsInput instanceof HTMLSelectElement ? Number(adultsInput.value || 1) : 1
    return index < adults ? 'Adult' : 'Child'
  }

  function renderCountryOptions(selectedCode = '') {
    return [
      '<option value="">Select Country</option>',
      ...countryOptions.map((country: { code: string; name: string }) => {
        const selected = country.code === selectedCode ? ' selected' : ''
        return `<option value="${country.code}"${selected}>${country.name}</option>`
      }),
    ].join('')
  }

  function getExistingPassengers() {
    if (!(passengerList instanceof HTMLElement)) return []
    return Array.from(passengerList.querySelectorAll('.passenger-entry')).map((entry) => {
      const fullNameInput = entry.querySelector('[name="passengerFullName"]')
      const passportInput = entry.querySelector('[name="passengerPassportId"]')
      const genderInput = entry.querySelector('[name="passengerGender"]')
      const countryInput = entry.querySelector('[name="passengerCountryCode"]')
      return {
        fullName: fullNameInput instanceof HTMLInputElement ? fullNameInput.value : '',
        passportId: passportInput instanceof HTMLInputElement ? passportInput.value : '',
        gender: genderInput instanceof HTMLSelectElement ? genderInput.value : '',
        countryCode: countryInput instanceof HTMLSelectElement ? countryInput.value : '',
      }
    })
  }

  function renderPassengerFields() {
    if (!(passengerList instanceof HTMLElement)) return
    const existingPassengers = getExistingPassengers()
    const passengerCount = getPassengerCount()
    passengerList.innerHTML = Array.from({ length: passengerCount }, (_, index) => {
      const passenger = existingPassengers[index] || { fullName: '', passportId: '', gender: '', countryCode: '' }
      const passengerNumber = index + 1
      const passengerType = getPassengerType(index)
      return `
        <section class="passenger-entry" aria-labelledby="passenger-${passengerNumber}-heading">
          <h3 id="passenger-${passengerNumber}-heading">${passengerType} ${passengerNumber}</h3>
          <div class="field">
            <label for="passenger-${passengerNumber}-name">Full Name (as per Passport)</label>
            <input id="passenger-${passengerNumber}-name" name="passengerFullName" type="text" autocomplete="name" minlength="2" maxlength="120" placeholder="e.g. John Michael Smith" value="${passenger.fullName.replaceAll('"', '&quot;')}" required />
          </div>
          <div class="field">
            <label for="passenger-${passengerNumber}-passport">Passport / ID Number</label>
            <input id="passenger-${passengerNumber}-passport" name="passengerPassportId" type="text" autocomplete="off" minlength="3" maxlength="80" value="${passenger.passportId.replaceAll('"', '&quot;')}" required />
          </div>
          <div class="field">
            <label for="passenger-${passengerNumber}-gender">Gender</label>
            <select id="passenger-${passengerNumber}-gender" name="passengerGender" required>
              <option value="">Select</option>
              <option value="Male"${passenger.gender === 'Male' ? ' selected' : ''}>Male</option>
              <option value="Female"${passenger.gender === 'Female' ? ' selected' : ''}>Female</option>
            </select>
          </div>
          <div class="field">
            <label for="passenger-${passengerNumber}-country">Country of Origin</label>
            <select id="passenger-${passengerNumber}-country" name="passengerCountryCode" required>
              ${renderCountryOptions(passenger.countryCode)}
            </select>
          </div>
        </section>
      `
    }).join('')
  }

  function getCountryName(countryCode: string) {
    return countryOptions.find((country: { code: string; name: string }) => country.code === countryCode)?.name || countryCode
  }

  function getPassengerPayload() {
    if (!(passengerList instanceof HTMLElement)) return []
    return Array.from(passengerList.querySelectorAll('.passenger-entry')).map((entry) => {
      const fullNameInput = entry.querySelector('[name="passengerFullName"]')
      const passportInput = entry.querySelector('[name="passengerPassportId"]')
      const genderInput = entry.querySelector('[name="passengerGender"]')
      const countryInput = entry.querySelector('[name="passengerCountryCode"]')
      const countryCode = countryInput instanceof HTMLSelectElement ? countryInput.value : ''
      return {
        fullName: fullNameInput instanceof HTMLInputElement ? fullNameInput.value : '',
        passportId: passportInput instanceof HTMLInputElement ? passportInput.value : '',
        gender: genderInput instanceof HTMLSelectElement ? genderInput.value : '',
        countryCode,
        countryName: getCountryName(countryCode),
      }
    })
  }

  function setCurrentStep(nextStep: number) {
    currentStep = Math.max(0, Math.min(nextStep, stepElements.length - 1))
    stepElements.forEach((stepElement) => {
      if (!(stepElement instanceof HTMLElement)) return
      stepElement.dataset.active = String(stepElement.dataset.step === String(currentStep))
    })
    stepIndicators.forEach((indicator) => {
      if (!(indicator instanceof HTMLElement)) return
      indicator.dataset.active = String(indicator.dataset.stepIndicator === String(currentStep))
    })
    if (prevButton instanceof HTMLButtonElement) prevButton.disabled = currentStep === 0
    if (nextButton instanceof HTMLButtonElement) {
      nextButton.hidden = currentStep === stepElements.length - 1
      nextButton.style.display = currentStep === stepElements.length - 1 ? 'none' : ''
    }
  }

  function validateCurrentStep() {
    const currentStepElement = stepElements[currentStep]
    if (!(currentStepElement instanceof HTMLElement)) return true
    const controls = Array.from(currentStepElement.querySelectorAll('input, select, textarea'))
    for (const control of controls) {
      if (control instanceof HTMLInputElement || control instanceof HTMLSelectElement || control instanceof HTMLTextAreaElement) {
        if (!control.reportValidity()) return false
      }
    }
    return true
  }

  function setStatus(message: string, isError = false) {
    if (!(statusOutput instanceof HTMLElement)) return
    statusOutput.textContent = message
    statusOutput.dataset.status = isError ? 'error' : 'success'
  }

  if (dateInput instanceof HTMLInputElement) {
    dateInput.min = new Date().toISOString().split('T')[0]
  }

  classInput?.addEventListener('change', updateTotal)
  adultsInput?.addEventListener('change', () => {
    updateTotal()
    renderPassengerFields()
  })
  childrenInput?.addEventListener('change', () => {
    updateTotal()
    renderPassengerFields()
  })
  updateTotal()
  renderPassengerFields()
  setCurrentStep(0)

  prevButton?.addEventListener('click', () => setCurrentStep(currentStep - 1))
  nextButton?.addEventListener('click', () => {
    if (!validateCurrentStep()) return
    setCurrentStep(currentStep + 1)
  })

  form?.addEventListener('submit', (event) => {
    event.preventDefault()

    if (!(form instanceof HTMLFormElement)) return
    if (!form.reportValidity()) return

    const data = new FormData(form)
    const passengers = getPassengerPayload()

    const messageLines = [
      'Hi Safari Rail, I would like to make a booking request.',
      '',
      'Class: ' + String(data.get('class') || ''),
      'Travel date: ' + String(data.get('date') || ''),
      'Departure: ' + String(data.get('departure') || ''),
      'Passengers: ' + String(data.get('adults') || 1) + ' adult(s), ' + String(data.get('children') || 0) + ' child(ren)',
      'Email: ' + String(data.get('email') || ''),
      '',
    ]

    passengers.forEach((passenger, index) => {
      messageLines.push(
        'Passenger ' + (index + 1),
        'Name: ' + passenger.fullName,
        'Passport/ID: ' + passenger.passportId,
        'Gender: ' + passenger.gender,
        'Country: ' + passenger.countryName,
        ''
      )
    })

    const message = messageLines.join('\n')
    const whatsappUrl = 'https://wa.me/254769869503?text=' + encodeURIComponent(message)

    window.location.assign(whatsappUrl)
  })
</script>

