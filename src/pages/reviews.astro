---
import BaseLayout from '../layouts/BaseLayout.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
---

<BaseLayout
  title="Traveller Reviews | Safari Rail"
  description="Read traveller reviews or contact Safari Rail to share feedback about your SGR booking assistance."
>
  <main id="main-content">
    <section class="subhero">
      <Header />
      <div>
        <p class="eyebrow">Traveller Feedback</p>
        <h1>Safari Rail Reviews</h1>
        <p>We publish traveller feedback after it has been reviewed and approved.</p>
      </div>
    </section>

    <section class="section reviews-section">
      <div class="section-heading">
        <p class="eyebrow">Recent Feedback</p>
        <div>
          <h2>What Travellers Say</h2>
          <p>Approved traveller feedback will appear here.</p>
        </div>
      </div>
      <div class="reviews-list" aria-live="polite">
        <p class="reviews-empty">There are no traveller reviews published yet. Please check back later.</p>
      </div>
      <div class="review-proof-strip" aria-label="External Safari Rail trust links">
        <a href="https://share.google/Ql7b2rJhdHozWweVJ" target="_blank" rel="noopener noreferrer">
          <strong>Google</strong>
          <span>View our Business Profile</span>
        </a>
        <a href="https://www.instagram.com/safarirail/" target="_blank" rel="noopener noreferrer">
          <strong>Instagram</strong>
          <span>@safarirail</span>
        </a>
        <a href="https://www.facebook.com/share/1FwYSRg5Td/" target="_blank" rel="noopener noreferrer">
          <strong>Facebook</strong>
          <span>Safari Rail</span>
        </a>
        <a href="https://wa.me/254769869503" target="_blank" rel="noopener noreferrer">
          <strong>WhatsApp</strong>
          <span>Message +254 769 869 503</span>
        </a>
      </div>
      <aside class="review-policy-note">
        <h2>How Reviews Work</h2>
        <p>Reviews are published after moderation. We do not display private booking details.</p>
      </aside>
    </section>

    <section class="section review-submit-section">
      <div class="section-heading">
        <p class="eyebrow">Share Your Experience</p>
        <div>
          <h2>Contact our team</h2>
          <p>Review submissions through this page are temporarily unavailable. You can contact us directly.</p>
          <p><a class="text-link" href="https://wa.me/254769869503">Message Safari Rail on WhatsApp</a></p>
          <p><a class="text-link" href="mailto:support@safarirail.co.ke">support@safarirail.co.ke</a></p>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
