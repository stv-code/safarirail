---
import BaseLayout from '../layouts/BaseLayout.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import {
  REVIEW_COUNTRIES,
  REVIEW_EMAIL_MAX_LENGTH,
  REVIEW_MAX_LENGTH,
  REVIEW_NAME_MAX_LENGTH,
  REVIEW_ROUTES,
  REVIEW_TRAVEL_MONTHS,
  REVIEW_TRAVELLER_TYPES,
} from '../config/reviews'
---

<BaseLayout
  title="Traveller Reviews | SafariRail"
  description="Read moderated SafariRail traveller reviews and submit feedback after using our SGR booking assistance."
>
  <main>
    <section class="subhero">
      <Header />
      <div>
        <p class="eyebrow">Traveller Feedback</p>
        <h1>SafariRail Reviews</h1>
        <p>Native reviews from travellers who used our SGR booking assistance, with travel context that helps future visitors judge what fits their trip.</p>
      </div>
    </section>

    <section class="section reviews-section">
      <div class="section-heading">
        <p class="eyebrow">Recent Feedback</p>
        <div>
          <h2>What Travellers Say</h2>
          <p>Reviews are moderated before publication. We show country, route, travel month, traveller type, rating, and whether the reviewer matched a stored booking email.</p>
        </div>
      </div>
      <div class="review-summary" id="review-summary" hidden></div>
      <div class="reviews-list" id="reviews-list" aria-live="polite">
        <p class="reviews-empty">Loading approved reviews...</p>
      </div>
    </section>

    <section class="section review-submit-section">
      <div class="section-heading">
        <p class="eyebrow">Share Your Experience</p>
        <div>
          <h2>Submit a Review</h2>
          <p>Add the email used for booking if you want us to verify the review. The email is private and never displayed publicly.</p>
        </div>
      </div>
      <form class="review-form" id="review-form">
        <div class="field">
          <label for="review-name">Name</label>
          <input id="review-name" name="name" type="text" maxlength={REVIEW_NAME_MAX_LENGTH} autocomplete="name" required />
        </div>
        <div class="field">
          <label for="review-country">Country</label>
          <select id="review-country" name="country" required>
            <option value="">Select country</option>
            {REVIEW_COUNTRIES.map((country) => <option value={country}>{country}</option>)}
          </select>
        </div>
        <div class="field">
          <label for="review-route">Route</label>
          <select id="review-route" name="route" required>
            <option value="">Select route</option>
            {REVIEW_ROUTES.map((route) => <option value={route}>{route}</option>)}
          </select>
        </div>
        <div class="field">
          <label for="review-travel-month">Travel Month</label>
          <select id="review-travel-month" name="travelMonth" required>
            <option value="">Select month</option>
            {REVIEW_TRAVEL_MONTHS.map((month) => <option value={month}>{month}</option>)}
          </select>
        </div>
        <div class="field">
          <label for="review-traveller-type">Traveller Type</label>
          <select id="review-traveller-type" name="travellerType" required>
            <option value="">Select type</option>
            {REVIEW_TRAVELLER_TYPES.map((type) => <option value={type}>{type}</option>)}
          </select>
        </div>
        <div class="field">
          <label for="review-rating">Rating</label>
          <select id="review-rating" name="rating" required>
            <option value="">Select rating</option>
            <option value="5">5 - Excellent</option>
            <option value="4">4 - Good</option>
            <option value="3">3 - Okay</option>
            <option value="2">2 - Poor</option>
            <option value="1">1 - Very poor</option>
          </select>
        </div>
        <div class="field">
          <label for="review-booking-email">Booking Email</label>
          <input id="review-booking-email" name="bookingEmail" type="email" maxlength={REVIEW_EMAIL_MAX_LENGTH} placeholder="Optional" autocomplete="email" />
        </div>
        <div class="field review-text-field">
          <label for="review-text">Review</label>
          <textarea id="review-text" name="reviewText" maxlength={REVIEW_MAX_LENGTH} required placeholder="Tell other travellers what was useful, clear, fast, or worth improving."></textarea>
        </div>
        <div class="review-honeypot" aria-hidden="true">
          <label for="review-website">Website</label>
          <input id="review-website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>
        <p class="form-status" id="review-status" role="status" aria-live="polite"></p>
        <button class="primary-button" type="submit">Submit Review</button>
      </form>
    </section>
  </main>
  <Footer />
</BaseLayout>

<script>
  type Review = {
    name: string
    rating: number
    route: string
    country?: string
    travelMonth?: string
    travellerType?: string
    reviewText: string
    createdAt?: string
    verifiedTraveller?: boolean
  }

  const reviewsList = document.querySelector('#reviews-list')
  const reviewSummary = document.querySelector('#review-summary')
  const reviewForm = document.querySelector('#review-form')
  const reviewStatus = document.querySelector('#review-status')
  const reviewSubmitButton = reviewForm?.querySelector('button[type="submit"]')

  const dateFormatter = new Intl.DateTimeFormat('en', {
    month: 'short',
    year: 'numeric',
  })

  function setReviewStatus(message: string, isError = false) {
    if (!(reviewStatus instanceof HTMLElement)) return
    reviewStatus.textContent = message
    reviewStatus.dataset.status = isError ? 'error' : 'success'
  }

  function escapeHtml(value: unknown) {
    return String(value)
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;')
      .replaceAll("'", '&#039;')
  }

  function renderStars(rating: number) {
    const safeRating = Math.max(1, Math.min(5, Number(rating) || 0))
    return `<span class="review-stars" aria-label="${safeRating} out of 5 stars">${'&#9733;'.repeat(safeRating)}${'&#9734;'.repeat(5 - safeRating)}</span>`
  }

  function formatReviewDate(value?: string) {
    if (!value) return 'Recently submitted'
    const date = new Date(value)
    if (Number.isNaN(date.getTime())) return 'Recently submitted'
    return dateFormatter.format(date)
  }

  function compactContext(review: Review) {
    return [review.country, review.route, review.travelMonth, review.travellerType].filter(Boolean).join(' / ')
  }

  function renderSummary(reviews: Review[]) {
    if (!(reviewSummary instanceof HTMLElement)) return
    if (reviews.length === 0) {
      reviewSummary.hidden = true
      reviewSummary.innerHTML = ''
      return
    }

    const average = reviews.reduce((sum, review) => sum + review.rating, 0) / reviews.length
    const verifiedCount = reviews.filter((review) => review.verifiedTraveller).length
    reviewSummary.hidden = false
    reviewSummary.innerHTML = `
      <article>
        <strong>${average.toFixed(1)}</strong>
        <span>Average rating</span>
      </article>
      <article>
        <strong>${reviews.length}</strong>
        <span>Approved reviews</span>
      </article>
      <article>
        <strong>${verifiedCount}</strong>
        <span>Verified travellers</span>
      </article>
    `
  }

  async function readJsonResponse(response: Response, fallbackMessage: string) {
    const contentType = response.headers.get('content-type') || ''
    if (!contentType.toLowerCase().includes('application/json')) {
      throw new Error(fallbackMessage)
    }
    return response.json()
  }

  function renderReviews(reviews: Review[]) {
    if (!(reviewsList instanceof HTMLElement)) return
    renderSummary(reviews)

    if (reviews.length === 0) {
      reviewsList.innerHTML = '<p class="reviews-empty">No approved reviews yet. Be the first to share your experience.</p>'
      return
    }

    reviewsList.innerHTML = reviews.map((review) => `
      <article class="review-card">
        <div class="review-card-header">
          <div>
            <h3>${escapeHtml(review.name)}</h3>
            <p class="review-meta">${escapeHtml(formatReviewDate(review.createdAt))}</p>
          </div>
          ${renderStars(review.rating)}
        </div>
        <p class="review-context">${escapeHtml(compactContext(review) || review.route || 'Madaraka Express')}</p>
        <div class="review-badges">
          ${review.verifiedTraveller ? '<span>Verified traveller</span>' : '<span>Moderated traveller review</span>'}
        </div>
        <p>${escapeHtml(review.reviewText)}</p>
      </article>
    `).join('')
  }

  async function loadReviews() {
    try {
      const response = await fetch('/api/reviews')
      const result = await readJsonResponse(response, 'Review service is not available on this deployment yet.')
      if (!response.ok) throw new Error(result.message || 'Could not load reviews.')
      renderReviews(Array.isArray(result.reviews) ? result.reviews : [])
    } catch {
      if (reviewsList instanceof HTMLElement) {
        reviewsList.innerHTML = '<p class="reviews-empty">Approved reviews are unavailable right now.</p>'
      }
    }
  }

  reviewForm?.addEventListener('submit', async (event) => {
    event.preventDefault()
    if (!(reviewForm instanceof HTMLFormElement)) return
    if (!reviewForm.reportValidity()) return

    const data = new FormData(reviewForm)
    const payload = {
      name: data.get('name'),
      country: data.get('country'),
      route: data.get('route'),
      travelMonth: data.get('travelMonth'),
      travellerType: data.get('travellerType'),
      rating: Number(data.get('rating') || 0),
      bookingEmail: data.get('bookingEmail'),
      reviewText: data.get('reviewText'),
      website: data.get('website'),
    }

    if (reviewSubmitButton instanceof HTMLButtonElement) {
      reviewSubmitButton.disabled = true
      reviewSubmitButton.textContent = 'Submitting...'
    }
    setReviewStatus('Submitting your review...')

    try {
      const response = await fetch('/api/reviews', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      })
      const result = await readJsonResponse(response, 'Review submissions are not available on this deployment yet.')
      if (!response.ok) {
        const details = Array.isArray(result.errors) ? ` ${result.errors.join(' ')}` : ''
        throw new Error(`${result.message || 'Review submission failed.'}${details}`)
      }
      reviewForm.reset()
      setReviewStatus('Thank you. Your review has been submitted and will appear after approval.')
    } catch (error) {
      setReviewStatus(error instanceof Error ? error.message : 'We could not submit your review right now.', true)
    } finally {
      if (reviewSubmitButton instanceof HTMLButtonElement) {
        reviewSubmitButton.disabled = false
        reviewSubmitButton.textContent = 'Submit Review'
      }
    }
  })

  loadReviews()
</script>