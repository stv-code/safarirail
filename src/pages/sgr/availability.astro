---
import BaseLayout from '../../layouts/BaseLayout.astro'
import Header from '../../components/Header.astro'
import Footer from '../../components/Footer.astro'
import '../../styles/availability.css'
---
<BaseLayout title="SGR Seat Availability | Safari Rail" description="Explore SGR travel dates and check seats for Express, Inter-County and Suswa services." robots="noindex, follow">
  <main id="main-content" class="seat-page">
    <section class="seat-masthead">
      <Header />
      <div class="seat-intro">
        <div><p class="eyebrow">A little planning. A great journey.</p><h1>See your seats. Pick your date.</h1><p>Compare First Class and Economy seats across your travel dates.</p></div>
        <div class="seat-source"><span aria-hidden="true">&#8599;</span><div>Kenya Railways data<small>Checked as you explore</small></div></div>
      </div>
    </section>
    <div class="seat-workspace">
      <section class="journey-picker" aria-label="Choose your journey">
        <div class="journey-top"><div class="service-tabs" role="group" aria-label="Train service">
          <button type="button" data-service="express" aria-pressed="true">Express</button>
          <button type="button" data-service="inter_county" aria-pressed="false">Inter-County</button>
          <button type="button" data-service="phase2" aria-pressed="false">Suswa</button>
        </div><label class="class-picker"><span>Seat class</span><select id="seat-class"><option value="all">All classes</option><option value="first">First Class</option><option value="economy">Economy</option></select></label><p id="service-description">Direct connections. Choose your departure.</p></div>
        <div class="route-fields">
          <label><span>From</span><select id="origin" disabled><option value="">Loading stations…</option></select></label>
          <button type="button" id="swap-route" aria-label="Swap origin and destination" disabled>&#8644;</button>
          <label><span>To</span><select id="destination" disabled><option value="">Loading stations…</option></select></label>
          <label id="departure-field"><span>Departure</span><select id="departure"><option value="3.00">Afternoon · 3 pm</option><option value="10.00">Night · 10 pm</option></select></label>
        </div>
        <div class="directory-line"><p id="directory-status" role="status">Connecting to Kenya Railways…</p><button type="button" id="retry-directory" hidden>Try again &#8635;</button></div>
      </section>
      <div class="seat-columns">
        <section class="seat-calendar" aria-labelledby="calendar-title">
          <div class="calendar-heading"><div><p class="eyebrow">Choose a travel date</p><h2 id="calendar-title">Seats at a glance.</h2></div><button type="button" id="retry-month" class="text-action" disabled>&#8635; Update dates</button></div>
          <div class="month-toolbar"><h3 id="month-label"></h3><div><button id="this-month" type="button">This month</button><button id="previous-month" type="button" aria-label="Previous month">&#8592;</button><button id="next-month" type="button" aria-label="Next month">&#8594;</button></div></div>
          <div class="seat-weekdays" aria-hidden="true"><span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span><span>Sun</span></div>
          <div class="seat-days" id="calendar-days" role="group" aria-label="Travel dates"></div>
          <div class="seat-legend" aria-label="Availability legend"><span><i class="first-class-dot"></i>First Class</span><span><i class="economy-dot"></i>Economy</span><span><i class="low"></i>Few left: under 20 per class</span><span><i class="sold-out"></i>Sold out</span><span><i class="unavailable"></i>Unknown</span></div>
          <div class="scan-status"><span id="scan-indicator" aria-hidden="true"></span><p id="month-status" role="status">Choose a route to explore dates.</p></div>
          <p class="calendar-footnote">Each date shows seats for the selected service and departure. Tap a date for train times and fares. Unchecked or unknown counts are shown as a dash, never zero.</p>
        </section>
        <section class="seat-detail" aria-labelledby="results-title" aria-live="polite" aria-atomic="false">
          <div class="detail-heading"><span class="eyebrow">Your selected journey</span><span class="detail-symbol" aria-hidden="true">&#8599;</span></div>
          <h2 id="results-title">Pick a day. Make a plan.</h2><p id="selected-route"></p>
          <p id="results-message">Select a date to see train times, seats and fares.</p>
          <div id="train-list"></div>
          <p id="last-checked" class="checked-stamp">No date checked yet.</p>
          <button type="button" id="refresh" class="seat-refresh" disabled>&#8635; Check this date again</button>
          <a class="official-link" href="https://metickets.krc.co.ke/" target="_blank" rel="noopener noreferrer">Continue on Kenya Railways <span aria-hidden="true">&#8599;</span></a>
          <p class="detail-note">Premium seats and special departures can be checked on the official portal.</p>
        </section>
      </div>
      <aside class="seat-notice"><span class="notice-mark" aria-hidden="true">i</span><div><strong>A seat check is the start, not a reservation.</strong><p>Results may be cached for up to 2 minutes. Seats can change before you book. Confirm availability and fares with Kenya Railways. An unknown result never means sold out.</p></div><a href="/#booking">Need booking assistance? &#8599;</a></aside>
      <noscript><p class="seat-notice">Enable JavaScript to check seats, or <a href="https://metickets.krc.co.ke/">visit Kenya Railways</a>.</p></noscript>
    </div>
  </main>
  <Footer />
</BaseLayout>
<script>
  import '../../lib/sgr/ui'
</script>
