---
import BaseLayout from '../../layouts/BaseLayout.astro'
import Header from '../../components/Header.astro'
import Footer from '../../components/Footer.astro'
---

<BaseLayout
  title="Check Open Seats | Safari Rail"
  description="View and check Madaraka Express seat availability by route and travel date."
  robots="noindex, follow"
>
  <main id="main-content" class="availability-page">
    <section class="availability-masthead">
      <Header />
      <div class="availability-intro">
        <p class="eyebrow">Plan your SGR journey</p>
        <h1>Check Open Seats</h1>
        <p>Choose a route and travel date to check Madaraka Express seat information.</p>
      </div>
    </section>

    <section class="availability-content" aria-labelledby="calendar-title">
      <div class="route-card">
        <label>
          <span>Origin</span>
          <select id="origin" aria-label="Origin station">
            <option value="nairobi-terminus">Nairobi Terminus</option>
            <option value="mombasa-terminus">Mombasa Terminus</option>
          </select>
        </label>
        <button class="swap-route" id="swap-route" type="button" aria-label="Swap origin and destination">↔</button>
        <label>
          <span>Destination</span>
          <select id="destination" aria-label="Destination station">
            <option value="mombasa-terminus">Mombasa Terminus</option>
            <option value="nairobi-terminus">Nairobi Terminus</option>
          </select>
        </label>
      </div>

      <div class="calendar-card">
        <div class="calendar-toolbar">
          <div>
            <p class="eyebrow">Select a date</p>
            <h2 id="calendar-title">Travel dates</h2>
          </div>
          <div class="month-controls">
            <button id="previous-month" type="button" aria-label="Previous month">‹</button>
            <strong id="month-label" aria-live="polite"></strong>
            <button id="next-month" type="button" aria-label="Next month">›</button>
          </div>
        </div>
        <div class="calendar-grid calendar-weekdays" aria-hidden="true">
          <span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span><span>Sun</span>
        </div>
        <div class="calendar-grid calendar-days" id="calendar-days" role="group" aria-label="Travel dates"></div>
        <div class="calendar-footer">
          <div class="availability-legend" aria-label="Availability legend">
            <span><i class="legend-dot available"></i>Available</span>
            <span><i class="legend-dot sold-out"></i>Sold out</span>
            <span><i class="legend-dot unchecked"></i>Unchecked</span>
            <span><i class="legend-dot unavailable"></i>Unavailable</span>
          </div>
          <button class="primary-button refresh-button" id="refresh" type="button" disabled>
            Check selected date
          </button>
        </div>
        <p class="last-checked" id="last-checked" aria-live="polite">No successful availability checks yet.</p>
      </div>

      <section class="train-results" aria-labelledby="results-title" aria-live="polite">
        <div>
          <p class="eyebrow">Train details</p>
          <h2 id="results-title">Select a travel date</h2>
        </div>
        <p id="results-message">Choose a date to see whether verified train details are available.</p>
        <div id="train-list"></div>
      </section>

      <aside class="availability-notice" aria-label="Availability information">
        <strong>Live seat counts are not connected yet. This calendar will not label a date sold out without a reliable result.</strong>
        <a href="https://metickets.krc.co.ke/" target="_blank" rel="noopener noreferrer">Check seats on Kenya Railways ↗</a>
        <strong>Availability information is indicative and may change. Confirm current availability through the official Kenya Railways booking portal.</strong>
        <p>This calendar checks dates only when you request a check. It does not reserve seats or take bookings. Days are not marked sold out when no reliable result is available.</p>
      </aside>
    </section>
  </main>

  <Footer />
</BaseLayout>

<script>
  import { fetchAvailability } from '../../lib/sgr/client'

  type DayStatus = 'unchecked' | 'unavailable' | 'available' | 'sold-out' | 'outside-window'
  const originSelect = document.querySelector<HTMLSelectElement>('#origin')!
  const destinationSelect = document.querySelector<HTMLSelectElement>('#destination')!
  const calendar = document.querySelector<HTMLDivElement>('#calendar-days')!
  const monthLabel = document.querySelector<HTMLElement>('#month-label')!
  const resultsTitle = document.querySelector<HTMLElement>('#results-title')!
  const resultsMessage = document.querySelector<HTMLElement>('#results-message')!
  const lastChecked = document.querySelector<HTMLElement>('#last-checked')!
  const refreshButton = document.querySelector<HTMLButtonElement>('#refresh')!
  const statuses = new Map<string, DayStatus>()
  let selectedDate = ''
  const today = new Date()
  let visibleMonth = new Date(today.getFullYear(), today.getMonth(), 1)

  const dateKey = (date: Date) => [
    date.getFullYear(),
    String(date.getMonth() + 1).padStart(2, '0'),
    String(date.getDate()).padStart(2, '0'),
  ].join('-')
  function renderCalendar() {
    monthLabel.textContent = new Intl.DateTimeFormat('en', { month: 'long', year: 'numeric' }).format(visibleMonth)
    calendar.replaceChildren()
    const firstDay = new Date(visibleMonth.getFullYear(), visibleMonth.getMonth(), 1)
    const offset = (firstDay.getDay() + 6) % 7
    const daysInMonth = new Date(visibleMonth.getFullYear(), visibleMonth.getMonth() + 1, 0).getDate()
    for (let i = 0; i < offset; i++) {
      const blank = document.createElement('span')
      blank.className = 'calendar-blank'
      blank.setAttribute('aria-hidden', 'true')
      calendar.append(blank)
    }
    for (let day = 1; day <= daysInMonth; day++) {
      const date = new Date(visibleMonth.getFullYear(), visibleMonth.getMonth(), day)
      const key = dateKey(date)
      const status = statuses.get(key) || 'unchecked'
      const button = document.createElement('button')
      button.type = 'button'
      button.className = `calendar-day state-${status}${selectedDate === key ? ' is-selected' : ''}`
      button.dataset.date = key
      button.setAttribute('aria-label', `${new Intl.DateTimeFormat('en', { dateStyle: 'full' }).format(date)}, ${status.replace('-', ' ')}`)
      button.setAttribute('aria-pressed', String(selectedDate === key))
      button.innerHTML = `<span>${day}</span><i aria-hidden="true"></i>`
      button.addEventListener('click', () => selectDate(key))
      calendar.append(button)
    }
  }

  function selectDate(date: string) {
    selectedDate = date
    refreshButton.disabled = false
    refreshButton.textContent = 'Check selected date'
    resultsTitle.textContent = new Intl.DateTimeFormat('en', { dateStyle: 'full', timeZone: 'UTC' }).format(new Date(`${date}T00:00:00Z`))
    resultsMessage.textContent = 'This date has not been checked.'
    document.querySelector('#train-list')!.replaceChildren()
    renderCalendar()
  }

  document.querySelector('#previous-month')?.addEventListener('click', () => {
    visibleMonth = new Date(visibleMonth.getFullYear(), visibleMonth.getMonth() - 1, 1)
    renderCalendar()
  })
  document.querySelector('#next-month')?.addEventListener('click', () => {
    visibleMonth = new Date(visibleMonth.getFullYear(), visibleMonth.getMonth() + 1, 1)
    renderCalendar()
  })
  document.querySelector('#swap-route')?.addEventListener('click', () => {
    const origin = originSelect.value
    originSelect.value = destinationSelect.value
    destinationSelect.value = origin
  })
  refreshButton.addEventListener('click', async () => {
    if (!selectedDate) return
    refreshButton.disabled = true
    refreshButton.textContent = 'Checking…'
    resultsMessage.textContent = 'Requesting an availability check…'
    try {
      const { ok, data: result } = await fetchAvailability(
        originSelect.value,
        destinationSelect.value,
        selectedDate,
      )
      if (ok && result.status === 'available') {
        statuses.set(selectedDate, 'available')
        lastChecked.textContent = result.lastChecked
          ? `Last successful check: ${new Date(result.lastChecked).toLocaleString()}`
          : 'Availability check complete.'
        resultsMessage.textContent = 'Verified train results are shown below.'
      } else {
        statuses.set(selectedDate, 'unavailable')
        resultsMessage.textContent = result.message || 'The source could not provide a reliable result. This does not mean the train is sold out.'
        lastChecked.textContent = 'No successful availability checks yet.'
      }
    } catch {
      statuses.set(selectedDate, 'unavailable')
      resultsMessage.textContent = 'The availability source could not be reached. This does not mean the train is sold out.'
      lastChecked.textContent = 'No successful availability checks yet.'
    } finally {
      renderCalendar()
      refreshButton.disabled = false
      refreshButton.textContent = 'Check selected date'
    }
  })
  originSelect.addEventListener('change', () => {
    statuses.clear()
    renderCalendar()
  })
  destinationSelect.addEventListener('change', () => {
    statuses.clear()
    renderCalendar()
  })
  renderCalendar()
</script>

<style>
  .availability-page { min-height: 60vh; }
  .availability-masthead { padding: 24px clamp(18px, 4vw, 56px) 54px; color: var(--white); background: linear-gradient(90deg, rgba(16,37,33,.91), rgba(16,37,33,.55)), url('/station/station-ticket-office-17.jpg') center / cover; }
  .availability-intro { width: min(1180px,100%); margin: 58px auto 0; }
  .availability-intro h1 { max-width: 780px; margin-bottom: 12px; font-size: clamp(3rem,7vw,5.8rem); }
  .availability-intro p:last-child { color: rgba(255,255,255,.82); font-size: 1.08rem; }
  .availability-content { width: min(1050px, calc(100% - 36px)); margin: -28px auto 64px; position: relative; }
  .route-card,.calendar-card,.train-results,.availability-notice { border-radius: var(--radius); background: var(--white); box-shadow: 0 12px 36px rgba(16,37,33,.09); }
  .route-card { display: grid; grid-template-columns: 1fr auto 1fr; gap: 18px; align-items: end; padding: 22px; margin-bottom: 18px; }
  .route-card label { display: grid; gap: 7px; color: var(--muted); font-size: .82rem; font-weight: 800; }
  .route-card select { min-height: 48px; width: 100%; padding: 0 12px; border: 1px solid #d7ddd8; border-radius: var(--radius); background: white; color: var(--ink); }
  .swap-route { width: 44px; height: 44px; border: 1px solid #d7ddd8; border-radius: 50%; background: var(--cream); color: var(--forest); cursor: pointer; font-size: 1.2rem; }
  .calendar-card { padding: clamp(18px,4vw,30px); }
  .calendar-toolbar { display: flex; align-items: end; justify-content: space-between; gap: 20px; margin-bottom: 24px; }
  .calendar-toolbar .eyebrow,.train-results .eyebrow { margin-bottom: 5px; }
  .calendar-toolbar h2,.train-results h2 { margin: 0; color: var(--forest); font-size: clamp(1.6rem,3vw,2.15rem); }
  .month-controls { display: flex; align-items: center; gap: 14px; color: var(--forest); }
  .month-controls strong { min-width: 142px; text-align: center; }
  .month-controls button { width: 40px; height: 40px; border: 1px solid #d7ddd8; border-radius: var(--radius); background: white; color: var(--forest); cursor: pointer; font-size: 1.6rem; line-height: 1; }
  .calendar-grid { display: grid; grid-template-columns: repeat(7,minmax(0,1fr)); gap: 8px; }
  .calendar-weekdays { margin-bottom: 8px; color: var(--muted); font-size: .78rem; font-weight: 800; text-align: center; }
  .calendar-days { grid-auto-rows: minmax(65px,auto); }
  .calendar-day { position: relative; display: flex; align-items: flex-start; justify-content: space-between; padding: 10px; border: 1px solid #e0e5e1; border-radius: var(--radius); background: #f5f6f4; color: var(--ink); text-align: left; cursor: pointer; }
  .calendar-day:hover { border-color: var(--leaf); }
  .calendar-day.is-selected { outline: 2px solid var(--forest); outline-offset: 1px; }
  .calendar-day i,.legend-dot { width: 9px; height: 9px; display: inline-block; border-radius: 50%; background: #a7b0ab; }
  .calendar-day.state-available i,.legend-dot.available { background: #23834e; }
  .calendar-day.state-sold-out i,.legend-dot.sold-out { background: #c7443d; }
  .calendar-day.state-unavailable i,.calendar-day.state-outside-window i,.legend-dot.unavailable { background: #d08a20; }
  .calendar-footer { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 18px; margin-top: 22px; }
  .availability-legend { display: flex; flex-wrap: wrap; gap: 12px 18px; }
  .availability-legend span { display: inline-flex; align-items: center; gap: 7px; color: var(--muted); font-size: .8rem; }
  .legend-dot { flex: none; }
  .refresh-button:disabled { opacity: .56; cursor: not-allowed; }
  .last-checked { margin: 14px 0 0; color: var(--muted); font-size: .82rem; }
  .train-results { display: grid; grid-template-columns: minmax(180px,.7fr) 1.3fr; gap: 12px 24px; align-items: start; margin-top: 18px; padding: clamp(20px,4vw,30px); }
  .train-results > p { margin: 0; color: var(--muted); line-height: 1.65; }
  #train-list { grid-column: 2; }
  .availability-notice { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px 22px; margin-top: 18px; padding: 20px 24px; border: 1px solid #e2d4b6; background: #fffaf0; color: var(--ink); }
  .availability-notice strong { flex: 1 1 500px; line-height: 1.6; }
  .availability-notice a { color: var(--coral); font-weight: 800; text-decoration: underline; }
  .availability-notice p { flex-basis: 100%; margin: 0; color: var(--muted); font-size: .84rem; line-height: 1.6; }
  @media(max-width:650px) {
    .availability-intro { margin-top: 42px; }
    .route-card { gap: 10px; padding: 14px; }
    .swap-route { width: 38px; height: 38px; }
    .calendar-toolbar { align-items: flex-start; flex-direction: column; }
    .month-controls { align-self: stretch; justify-content: space-between; }
    .calendar-grid { gap: 4px; }
    .calendar-days { grid-auto-rows: minmax(52px,auto); }
    .calendar-day { padding: 7px; font-size: .85rem; }
    .calendar-day i { width: 7px; height: 7px; }
    .train-results { grid-template-columns: 1fr; }
    #train-list { grid-column: auto; }
    .refresh-button { width: 100%; }
  }
</style>
