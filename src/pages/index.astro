---
import BaseLayout from '../layouts/BaseLayout.astro'
import Header from '../components/Header.astro'
import BookingPanel from '../components/BookingPanel.astro'
import Footer from '../components/Footer.astro'
import { guides } from '../data/guides'
import { bookingExperience, formatKes, paymentMethods, siteConfig, ticketClasses, whatsappBaseUrl } from '../config/business'

const infoStrip = [
  'Independent booking assistance for travellers without M-Pesa',
  bookingExperience.responseTimeLabel,
  'Tickets delivered via Email, WhatsApp or Telegram',
]

const faqs = [
  ['Are you the official SGR website?', 'No. We are a private third-party agency helping tourists book tickets. We are NOT selling tickets - we assist you in booking them. The official website is metickets.krc.co.ke.'],
  ['How do I receive my ticket?', 'After booking, we send the M-Pesa message and ticket number to your email, WhatsApp, or Telegram. You MUST use this message to physically print your ticket at the station before boarding.'],
  ['What payment methods do you accept?', 'We accept Wise, Remitly, Sendwave, and Western Union (all remitted to M-Pesa), as well as USDT, BTC, and BNB crypto.'],
  ['What is your refund and cancellation policy?', 'We do not handle refunds. Cancellation is strictly handled by Kenya Railways in person at the station.'],
  ['Do children travel for free?', 'Children under 3 years travel free. Children aged 3-11 pay a reduced child fare.'],
]

const stationPhotos = [
  { src: '/optimized/station-17.webp', alt: 'Entrance to Nairobi Terminus', label: 'Nairobi Terminus' },
  { src: '/optimized/station-22.webp', alt: 'SGR station ticket office', label: 'Ticket collection' },
  { src: '/optimized/station-25.webp', alt: 'Ticket machines at the SGR station', label: 'Before you board' },
]

---

<BaseLayout>
  <main id="main-content">
    <section class="hero">
      <Header />
      <div class="journey-hero">
        <div class="hero-content">
          <p class="eyebrow">Kenya, one train journey away</p>
          <h1>Your SGR journey.<br /><em>Our local support.</em></h1>
          <p class="hero-copy">Nairobi to Mombasa, made easier. We help travellers book Madaraka Express tickets, even without M-Pesa or a Kenyan bank account.</p>
          <div class="hero-actions">
            <a class="primary-button" href="#booking">Plan my journey <span aria-hidden="true">&#8599;</span></a>
            <a class="ghost-button" href={whatsappBaseUrl} target="_blank" rel="noopener noreferrer">Talk on WhatsApp</a>
          </div>
          <p class="hero-caveat">Independent booking assistance. Clear service fees. Pay after availability is confirmed.</p>
          <div class="route-line" aria-label="Nairobi to Mombasa"><span>Nairobi</span><i aria-hidden="true"></i><span>Mombasa</span></div>
        </div>
        <figure class="hero-photo">
          <img src="/optimized/nairobi-terminus.webp" srcset="/optimized/station-17.webp 800w, /optimized/nairobi-terminus.webp 1280w" sizes="(max-width: 760px) 100vw, 48vw" alt="Nairobi Terminus, the starting point for your SGR journey to Mombasa" width="1280" height="960" fetchpriority="high" />
          <figcaption><span>Start your next chapter</span><strong>Nairobi Terminus, Kenya</strong></figcaption>
          <div class="journey-tag"><span>From</span><strong>KES {formatKes(ticketClasses[0].adultPrice)}</strong><span>per adult &middot; Economy, including our fee</span></div>
        </figure>
      </div>
    </section>

    <section class="info-strip" aria-label="Booking benefits">
      {infoStrip.map((item) => <span>{item}</span>)}
    </section>

    <section class="section journey-intro" id="how-it-works">
      <div class="section-heading">
        <p class="eyebrow">A little help. A great journey.</p>
        <div><h2>You plan the adventure.<br />We help with the tickets.</h2><p>Speak to a local team, understand the total cost, and travel with your booking details ready.</p></div>
      </div>
      <div class="process-grid">
        <article><span>01</span><h3>Tell us your plans</h3><p>Choose your travel date, class and passengers. Send a request online or start with a WhatsApp conversation.</p></article>
        <article><span>02</span><h3>Confirm, then pay</h3><p>We check seats and confirm the fare, service fee and payment instructions before you pay.</p></article>
        <article><span>03</span><h3>Get ready to go</h3><p>Receive your booking details and ticket-printing guidance. We help you understand what happens next.</p></article>
      </div>
    </section>

    <section class="section pricing-section" id="pricing">
      <div class="section-heading">
        <p class="eyebrow">Your seat, your choice</p>
        <div>
          <h2>Find your kind of comfortable.</h2>
          <p>All prices include our booking assistance fee. Select the class that suits your travel style.</p>
        </div>
      </div>
      <div class="pricing-grid">
        {ticketClasses.map((tier) => (
          <article class={`pricing-card ${tier.badge ? 'featured' : ''}`}>
            {tier.badge && <p class="pricing-badge">{tier.badge}</p>}
            <h3>{tier.label}</h3>
            <div class="price"><sup>KES</sup> {formatKes(tier.adultPrice)}</div>
            <p class="price-unit">per adult &middot; assistance fee included</p>
            <div class="fare-breakdown">
              <strong>Fare Breakdown</strong>
              <span>Adult: {formatKes(tier.adultPrice)} (ticket {formatKes(tier.ticketAdult)} + service {formatKes(tier.service)})</span>
              <span>Child (3-11): {formatKes(tier.childPrice)} (ticket {formatKes(tier.ticketChild)} + service {formatKes(tier.service)})</span>
              <span>Child (&lt;3): Free</span>
            </div>
            <ul>
              {tier.features.map((feature) => <li>{feature}</li>)}
            </ul>
            <button class="primary-button pricing-select" type="button" data-ticket-class={tier.label}>Choose {tier.label} <span aria-hidden="true">&#8599;</span></button>
          </article>
        ))}
      </div>
    </section>

    <section class="section booking-section" id="booking">
      <div class="section-heading"><p class="eyebrow">Let's get you there</p><div><h2>Start your booking request.</h2><p>No payment is taken here. We confirm seat availability first. Need a different route? <a class="text-link" href={whatsappBaseUrl}>Talk to us on WhatsApp.</a></p></div></div>
      <BookingPanel />
    </section>

    <section class="image-feature">
      <div>
        <p class="eyebrow">Ticket delivery</p>
        <h2>A little guidance, right to the platform.</h2>
        <p>
          After booking, your details are sent to your email, WhatsApp, or Telegram. You must use that message to physically print your ticket at the station before boarding.
        </p>
        <p>
          For many confirmed bookings, we also help pre-print physical tickets before departure and arrange a simple handover, so tourists do not have to figure out the station machines on arrival. This is a complimentary support service offered when timing and station access allow. Travellers will still receive all ticket details digitally and can print at the station if needed.
        </p>
      </div>
    </section>

    <section class="section station-gallery-section">
      <div class="section-heading">
        <p class="eyebrow">Station Photos</p>
        <div>
          <h2>Know where to print your ticket.</h2>
          <p>A look at the station and ticket collection facilities before you travel.</p>
        </div>
      </div>
      <div class="station-gallery">
        {stationPhotos.map((photo) => (
          <figure>
            <img src={photo.src} alt={photo.alt} width="800" height="600" loading="lazy" decoding="async" />
            <figcaption>{photo.label}</figcaption>
          </figure>
        ))}
      </div>
    </section>

    <section class="section guides-section" id="travel-guides">
      <div class="section-heading"><p class="eyebrow">Before you set off</p><div><h2>A smoother trip starts here.</h2><p>Practical answers for planning your first train journey in Kenya.</p></div></div>
      <div class="guide-grid">{guides.map((guide, index) => <a class="guide-card" href={`/guides/${guide.slug}`}><span class="guide-number">0{index + 1} / Travel guide</span><h3>{guide.title}</h3><p>{guide.description}</p><span class="text-link">Read the guide <span aria-hidden="true">&#8599;</span></span></a>)}</div>
    </section>

    <section class="section payment-section">
      <div class="section-heading">
        <p class="eyebrow">Payment options</p>
        <div>
          <h2>Choose your payment method</h2>
          <p>Submit your booking request first, then follow the payment instructions we confirm. Tickets are sent after payment is received. User is responsible for any transfer delays.</p>
        </div>
      </div>
      <div class="payment-grid">
        {paymentMethods.map(({ method, detail }) => (
          <article>
            <h3>{method}</h3>
            <p>{detail}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="section faq-section" id="faq">
      <div class="section-heading">
        <p class="eyebrow">Common Questions</p>
        <div>
          <h2>Good questions. Clear answers.</h2>
          <p>Everything you need to know before booking with us.</p>
        </div>
      </div>
      <div class="faq-list">
        {faqs.map(([question, answer]) => (
          <details>
            <summary>{question}</summary>
            <p>{answer}</p>
          </details>
        ))}
      </div>
      <p class="official-faq">
        More questions? <a href={siteConfig.officialKrcFaqUrl} target="_blank" rel="noopener noreferrer">View official KRC FAQs</a>
      </p>
    </section>

    <section class="section contact-section" id="contact">
      <div class="section-heading">
        <p class="eyebrow">Get in Touch</p>
        <div>
          <h2>Need Help?</h2>
          <p>Custom itineraries, group bookings, or general questions.</p>
        </div>
      </div>
      <div class="contact-grid">
        <div class="contact-card">
          <h3>Email</h3>
          <a href={`mailto:${siteConfig.supportEmail}`}>{siteConfig.supportEmail}</a>
        </div>
        <div class="contact-card">
          <h3>WhatsApp</h3>
          <a href={whatsappBaseUrl} target="_blank" rel="noopener noreferrer">{siteConfig.whatsappDisplay}</a>
        </div>

      </div>
      <form class="contact-form" id="contact-form">
        <div class="field">
          <label for="contact-name">Your Name</label>
          <input id="contact-name" name="name" type="text" placeholder="John Smith" required />
        </div>
        <div class="field">
          <label for="contact-email">Email Address</label>
          <input id="contact-email" name="email" type="email" placeholder="john@example.com" required />
        </div>
        <div class="field">
          <label for="message">Message</label>
          <textarea id="message" name="message" placeholder="I need help with a group booking for..." required></textarea>
        </div>
        <p class="contact-note">This opens your email app with your message. For a quicker conversation, use WhatsApp.</p>
        <button class="primary-button" type="submit">Open email draft</button>
      </form>
    </section>

    <section class="cta-section">
      <div>
        <p class="eyebrow">From city to coast</p>
        <h2>Your next adventure starts with a conversation.</h2>
      </div>
      <a class="primary-button" href="#booking">Plan my journey</a>
    </section>
  </main>
  <Footer />
</BaseLayout>

<script is:inline define:vars={{ supportEmail: siteConfig.supportEmail }}>
  const contactForm = document.querySelector('#contact-form')

  contactForm?.addEventListener('submit', (submitEvent) => {
    submitEvent.preventDefault()

    if (!(contactForm instanceof HTMLFormElement)) return

    const data = new FormData(contactForm)
    const name = data.get('name') || ''
    const email = data.get('email') || ''
    const message = data.get('message') || ''
    const body = [`Name: ${name}`, `Email: ${email}`, '', String(message)].join('\n')

    window.location.href = `mailto:${supportEmail}?subject=Safari Rail%20Message&body=${encodeURIComponent(body)}`
  })

  document.querySelectorAll('.pricing-select').forEach((button) => {
    button.addEventListener('click', () => {
      if (!(button instanceof HTMLElement)) return
      const selectedClass = button.dataset.ticketClass
      const classInput = document.querySelector('#class')
      const bookingForm = document.querySelector('#booking-panel')
      if (selectedClass && classInput instanceof HTMLSelectElement) {
        classInput.value = selectedClass
        classInput.dispatchEvent(new Event('change', { bubbles: true }))
      }
      bookingForm?.scrollIntoView({ behavior: 'smooth', block: 'start' })
    })
  })
</script>
